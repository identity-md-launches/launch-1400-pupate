{
  "name": "pupate-keeper",
  "version": "0.1.0",
  "private": true,
  "description": "Pupate's off-chain tools: the IMD paid-action client (oracle requests, the launch) and the keeper that runs Cocoon's public steps.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "imd": "bin/imd.mjs",
    "pupate-keeper": "bin/keeper.mjs"
  },
  "scripts": {
    "check:floor": "node bin/imd.mjs check oracle.request questions/floor.check.json",
    "keeper:status": "node bin/keeper.mjs --status",
    "keeper:once": "node bin/keeper.mjs --once",
    "keeper:loop": "node bin/keeper.mjs --loop",
    "test:fork": "node test/fork.mjs"
  },
  "dependencies": {
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "viem": "^2.21.0"
  }
}
